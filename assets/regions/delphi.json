 "cards": {
  "athenian_treasury": {
   "title": "Treasury of the Athenians",
   "epithet": "On the Sacred Way",
   "text": "A small Doric treasury of Parian marble, its metopes carved with Herakles and Theseus; whether it was built about 510 or after Marathon in 490 is debated."
  },
  "delphi_apollo": {
   "title": "Temple of Apollo",
   "epithet": "The Alkmaeonid temple",
   "text": "Apollo's temple, rebuilt after a fire in the late sixth century; the Alkmaeonids, an Athenian family in exile, gave it a front of marble. Here the Pythia spoke the god's answers to those who came to ask."
  },
  "god_away": {
   "title": "The god's winter",
   "epithet": "Delphi, December to February",
   "text": "Plutarch, a priest at Delphi, says that for the three winter months the paean fell silent and Dionysus was honoured instead, while Apollo was thought to be away in the north. No consultants queued; in spring the god returned and the Pythia spoke again, on the seventh day of the month."
  }
 },
 "strings": {
  "first_visit": "Delphi under the shining cliffs. The Sacred Way climbs to Apollo's temple.",
  "pythia_returns": "Apollo is back from the north: the first consultation of the year.",
  "season_turn.winter": "The paean is silent: these three months belong to Dionysus.",
  "season_turn.spring": "Meltwater roars down the gorges.",
  "season_turn.apr": "The swallows are back under the eaves.",
  "season_turn.summer": "The flocks are on the high pastures.",
  "season_turn.autumn": "The flocks come down to the lowlands.",
  "season_turn.oct": "The woods are turning copper and gold."
 },
