 "cards": {
  "ishtar_gate": {
   "title": "Ishtar Gate",
   "epithet": "The blue gate",
   "text": "Nebuchadnezzar's gate of about 575 BC, faced with blue glazed bricks bearing aurochs and the dragon mušḫuššu in relief; the procession of the spring festival passed through it."
  },
  "processional_way": {
   "title": "Processional Way",
   "epithet": "The street of lions",
   "text": "The paved way from the Ishtar Gate south through the city, its walls faced with glazed bricks showing striding lions."
  },
  "etemenanki": {
   "title": "Etemenanki",
   "epithet": "The great ziggurat",
   "text": "Marduk's stepped temple tower beside his temple Esagila. How much of it stood under Xerxes is debated; it is shown standing."
  },
  "winter_court": {
   "title": "The king's winter",
   "epithet": "Babylon, as Greek writers say",
   "text": "Xenophon writes that the Persian king spent seven winter months in Babylon, three spring months at Susa and two summer months at Ecbatana. Other Greek writers say much the same. The court's moves are not described in any Persian record, so the game shows them as Greek writers say."
  }
 },
 "strings": {
