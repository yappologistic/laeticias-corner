 "cards": {
  "altis": {
   "kind": "landmark",
   "title": "Altis",
   "epithet": "Zeus' precinct at Olympia",
   "text": "The walled grove of Zeus, crowded with altars and statues, where the games are held every four years. The temple of Zeus, finished about 456, Pheidias' workshop and the stadium are not drawn here: the stop shows the wall, altars, statue bases and olives made of common Greek pieces."
  },
  "xyleus": {
   "kind": "role",
   "title": "Xyleus",
   "epithet": "",
   "text": "Pausanias says a woodman supplied the white poplar used for every sacrifice to Zeus at Olympia, and no other wood."
  },
  "olympia_festival": {
   "kind": "idea",
   "title": "The Olympic festival",
   "epithet": "432 BC, the 87th",
   "text": "Every fourth summer heralds proclaimed a truce and Greeks from every city came to Zeus' precinct: five days of sacrifice and contests, the great sacrifice of oxen at the ash altar, and the olive crown for the victors. 432 BC was a festival year; the Spartan stadion victor was praised by poets."
  }
 },
