 "cards": {
  "sidon": {
   "kind": "landmark",
   "title": "Sidon",
   "epithet": "A Phoenician harbour",
   "text": "A Phoenician city of ships and timber under the Persian king, whose fleet it served; cedar from the mountains behind it was famous. The temple of Eshmun outside the city is not drawn here: the stop shows a harbour, logs on the strand and houses made of common pieces."
  },
  "sidon_ships": {
   "kind": "role",
   "title": "Shipwright",
   "epithet": "",
   "text": "Sidon's ships were the best in Xerxes' fleet, Herodotus says, and its king sat next to the Great King."
  },
  "purple": {
   "kind": "role",
   "title": "Dyer",
   "epithet": "",
   "text": "Phoenician dyers boiled sea snails for the purple that made their cloth famous, and their beaches stank of it."
  }
 },
 "strings": {
  "first_visit": "Sidon: ships, cedar logs and a harbour on the Levant coast.",
  "market_day": "Market day: stalls, voices and goods from the country around.",
  "market_rain": "Rain: the stallholders cover their goods and wait under the eaves.",
  "lamps_lit": "Dusk: the lamps are lit along the street.",
  "wedding": "A wedding: the bride is led to her new home with torches and songs.",
  "shearing": "Shearing time: wool for the looms.",
  "early_market": "The market opens at dawn, before the heat.",
  "harvest_in": "The harvest is carried in to the stores.",
  "winter_fires": "Fires in the doorways against the cold evening.",
  "season_turn.spring": "The swallows are back under the eaves.",
  "season_turn.summer": "The cicadas have started.",
  "season_turn.autumn": "The grapes are in: the vintage begins.",
  "season_turn.oct": "The first rain. The whole land smells of dust and earth.",
  "season_turn.winter": "Snow on the heights."
 },
