 "cards": {
  "brundisium_harbour": {"kind": "landmark", "title": "Portus Brundisinus", "text": "A branching natural harbour with quays and warehouses, sheltered from the open sea. Here the Via Appia ends, and ships sail across the Ionian Sea for Greece and the East.", "epithet": "The harbour for Greece"},
  "appia_end": {"kind": "idea", "title": "Finis Viae Appiae", "text": "The Via Appia, the 'queen of roads', runs some 580 kilometres from the Porta Capena in Rome to this harbour. A column marks its end; two stand on the waterfront today, and the date of the surviving one is debated, so the game shows a simple marker column.", "epithet": "The road's end"},
  "crossing": {"kind": "idea", "title": "Traiectus", "text": "From Brundisium ships cross the Ionian Sea to Dyrrachium or Apollonia in a day or two with a fair wind, and travellers go on by the Via Egnatia to the East; others sail round to Corinth. In winter few ships risk the open sea.", "epithet": "The crossing to Greece"},
  "virgil": {"kind": "idea", "title": "Vergilius", "text": "The poet of the Aeneid fell ill in Greece and died here, at Brundisium, in 19 BC, on his way home with Augustus. He had asked for the unfinished poem to be burned; Augustus had it published instead, and it became Rome's own epic.", "epithet": "Virgil's last journey"},
  "passenger": {"kind": "role", "title": "Vector", "text": "A passenger waits on the quay with his baggage for a ship and a fair wind to Greece."},
  "crossing_sailor": {"kind": "role", "title": "Nauta", "text": "A sailor of a Greek merchant ship hauls ropes and stows the cargo for the crossing."},
  "merchant": {"kind": "role", "title": "Mercator", "text": "A merchant bargains on the quay over wine, oil and wool bound for the Greek ports."},
  "customs_officer": {"kind": "role", "title": "Portitor", "text": "A customs officer checks the cargo and the declaration before goods leave the quay."},
  "compitum": {"kind": "role", "title": "Compitum", "text": "A shrine of the Lares at a crossroads, tended by the neighbourhood's magistrates; its lamp is lit at dusk."},
  "women": {"kind": "role", "title": "Mulieres", "text": "Women fetch water, shop, work at looms and counters, visit neighbours and keep the household going."},
  "plebs": {"kind": "role", "title": "Plebs", "text": "Ordinary citizens in coloured or undyed tunics: shopkeepers, craftsmen, labourers and clients. The toga is for formal business and the games."},
  "children": {"kind": "role", "title": "Pueri et puellae", "text": "Children play with walnuts, knucklebones and hoops in the street; boys wear a bulla, girls a lunula."},
  "enslaved": {"kind": "role", "title": "Servus", "text": "Perhaps a fifth to a third of Rome's people are enslaved. They wear no special dress; you know them only by the work they are made to do."},
  "freedman": {"kind": "role", "title": "Libertus", "text": "A freed man or woman running a shop: Rome's small trade was largely in their hands."},
  "popina": {"kind": "role", "title": "Popina", "text": "Late diners and drinkers leave the street counters with lamps; the night watch keeps an eye on them."},
  "dogs": {"kind": "role", "title": "Canes", "text": "Dogs guard doors (cave canem, says the mosaic) and roam the streets for scraps."},
  "cats": {"kind": "role", "title": "Feles", "text": "Cats have become common in Roman houses and shops, good at keeping mice from the grain."},
  "taberna": {"kind": "role", "title": "Taberna", "text": "A shop open to the street with a masonry counter, closed at night with wooden shutters, selling bread, oil, cloth or lamps."},
  "thermopolium": {"kind": "role", "title": "Thermopolium", "text": "A street counter with sunk jars of hot food and wine; most flats have no kitchen, so people eat here."},
  "baker": {"kind": "role", "title": "Pistor", "text": "The baker kneads, shapes, stamps and bakes before dawn; donkeys turn his lava mills."},
  "smith": {"kind": "role", "title": "Faber ferrarius", "text": "A smith at his forge making nails, tools, hinges and fittings for the quarter."},
  "fountain": {"kind": "role", "title": "Lacus", "text": "Street fountains stand every few blocks, running day and night; women and children fetch water and news there."},
  "tombs": {"kind": "role", "title": "Sepulcra", "text": "Burial is forbidden inside the city, so tombs line the roads leading out of it; families visit with offerings."},
  "docker": {"kind": "role", "title": "Saccarius", "text": "Dockers carry sacks and amphorae from the barges to the warehouses; they had their own guilds."},
  "fish_market": {"kind": "role", "title": "Piscator", "text": "River fishermen land their catch for the stalls of the cattle market."},
  "cursus_role": {"kind": "role", "title": "Viator", "text": "A traveller on the Via Appia, resting at the relay stations between Rome and the south."}
 },
