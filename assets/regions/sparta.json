 "cards": {
  "sparta": {
   "kind": "landmark",
   "title": "Sparta",
   "epithet": "Villages without a wall",
   "text": "Sparta is a cluster of villages in the Eurotas valley, not a walled city: Thucydides remarks that it was never built up as one. The sanctuary of Athena of the Bronze House on the low acropolis is not drawn here: the stop shows farmhouses and a shrine made of common Greek pieces."
  },
  "helot": {
   "kind": "role",
   "title": "Helot",
   "epithet": "",
   "text": "The land of Sparta was worked by helots, an unfree people bound to it, who gave half its yield to their Spartan masters."
  },
  "agoge": {
   "kind": "role",
   "title": "Agoge",
   "epithet": "",
   "text": "Spartan boys left home at seven for the agoge, a hard common training in packs under older youths."
  },
  "sparta_mess": {
   "kind": "idea",
   "title": "Syssitia",
   "epithet": "The common meals",
   "text": "Every Spartiate ate in a mess of about fifteen men and paid his share each month in barley, wine, cheese and figs, Plutarch says. A man who could not pay lost his full rights. The famous black broth was eaten there."
  },
  "karneia": {
   "kind": "idea",
   "title": "The Karneia",
   "epithet": "Apollo's festival at Sparta",
   "text": "In late summer the Spartans kept the Karneia for Apollo: men feasted in tents in imitation of a camp, young men raced, and music contests were held. While it lasted no Spartan army marched, which is why only a few were at Thermopylae in 480."
  }
 },
 "strings": {
  "first_visit": "Sparta: farmhouses in the Eurotas valley, and no wall.",
  "lamps_lit": "Dusk: the lamps are lit along the street.",
  "wedding": "A wedding: the bride is led to her new home with torches and songs.",
  "shearing": "Shearing time: the flocks come in.",
  "threshing": "The threshing floors are busy from dawn.",
  "vintage": "The vintage: the grapes are trodden in the vats.",
  "rural_dionysia": "The country Dionysia: a procession with songs, a goat and the aulos.",
  "karneia": "The Karneia: the Spartans feast in tents, and no army marches.",
  "season_turn.spring": "The swallows are back under the eaves.",
  "season_turn.summer": "The cicadas have started.",
  "season_turn.autumn": "The grapes are in: the vintage begins.",
  "season_turn.nov": "Cranes call high overhead, flying in a long V.",
  "season_turn.oct": "The first rain. The whole land smells of dust and earth.",
  "season_turn.winter": "Braziers glow in the doorways against the cold."
 },
