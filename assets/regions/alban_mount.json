 "cards": {
  "latiaris": {"kind": "landmark", "title": "Iuppiter Latiaris", "text": "Jupiter's sanctuary on the summit of the Alban Mount, the old meeting place of the Latin peoples, where the consuls lead the Latin Festival each year. Below it lies the round crater lake; the Via Appia passes at the mount's foot.", "epithet": "On the Alban Mount"},
  "feriae_latinae": {"kind": "idea", "title": "Feriae Latinae", "text": "Each year, on a day the new consuls set, usually in spring, Rome's magistrates climb the Alban Mount with delegates of the old Latin towns. A white bull is sacrificed to Jupiter Latiaris and its meat shared among the towns, a memory of the league that Rome once led and then swallowed. The game shows it on the third day of spring.", "epithet": "The Latin Festival"},
  "lake": {"kind": "idea", "title": "Lacus Albanus", "text": "The lake fills the crater of an old volcano. In the war against Veii, Livy says, the Romans cut a tunnel to drain its rising water, and the outlet is still there. Fishermen work its shores, and mist lies on it on spring mornings.", "epithet": "The crater lake"},
  "alban_wine": {"kind": "idea", "title": "Vinum Albanum", "text": "The volcanic slopes of the Alban hills made a wine Romans praised; Horace and Pliny both name it. Villas on the slopes send it down by mule to the Via Appia, where carts take it on to Rome's tables and taverns.", "epithet": "Alban wine"},
  "pilgrim": {"kind": "role", "title": "Peregrinator", "text": "Pilgrims climb the paved way to Jupiter's sanctuary to pray and make an offering."},
  "woodcutter": {"kind": "role", "title": "Lignator", "text": "Woodcutters fell oak and chestnut in the woods of the mount for firewood and charcoal."},
  "shepherd": {"kind": "role", "title": "Pastor", "text": "Shepherds bring their flocks to graze on the hills and the Campagna; the Parilia is their festival."},
  "dogs": {"kind": "role", "title": "Canes", "text": "Dogs guard doors (cave canem, says the mosaic) and roam the streets for scraps."},
  "farmer": {"kind": "role", "title": "Agricola", "text": "Farmers and tenants work the market gardens, fields and olive yards round the city."},
  "vinedresser": {"kind": "role", "title": "Vinitor", "text": "Vine-dressers prune, tie and hoe the vines on the hills outside the city."},
  "tombs": {"kind": "role", "title": "Sepulcra", "text": "Burial is forbidden inside the city, so tombs line the roads leading out of it; families visit with offerings."},
  "swallows": {"kind": "role", "title": "Hirundines", "text": "The swallows are back with the spring, swooping over the river and the rooftops."},
  "flamen": {"kind": "role", "title": "Flamen", "text": "A priest of one god, in a heavy cloak and the apex, a cap topped with a spike of olive wood."},
  "enslaved": {"kind": "role", "title": "Servus", "text": "Perhaps a fifth to a third of Rome's people are enslaved. They wear no special dress; you know them only by the work they are made to do."},
  "cursus_role": {"kind": "role", "title": "Viator", "text": "A traveller on the Via Appia, resting at the relay stations between Rome and the south."},
  "mules": {"kind": "role", "title": "Muli", "text": "Pack mules carry loads by day, when carts are banned from the streets."},
  "site_cart": {"kind": "role", "title": "Plaustrum", "text": "Ox carts for public building may run by day; most other heavy carts must wait for dusk."}
 },
 "strings": {
  "first_visit": "The Alban Mount. The paved way climbs to Jupiter's sanctuary above the crater lake; in winter its summit is white.",
