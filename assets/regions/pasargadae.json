 "cards": {
  "pasargadae_garden": {
   "title": "Palace P and its garden",
   "epithet": "Cyrus' garden",
   "text": "Cyrus' palace faces a garden watered by narrow stone channels and square basins, cut in limestone; cypresses and planes grow along them."
  },
  "cyrus_tomb": {
   "title": "Tomb of Cyrus",
   "epithet": "On six steps",
   "text": "The tomb of Cyrus the Great, a gabled stone chamber on six steps in a watered grove. The magi who keep it, father to son since Cambyses, receive a sheep a day and a horse a month. Two centuries later Alexander found it robbed and had it restored (Arrian 6.29)."
  },
  "cyrus": {
   "title": "Kūruš",
   "epithet": "Cyrus, founder (a memory)",
   "text": "Cyrus joined Persians, Medes and Elamites into one empire and took Lydia and Babylon. He rests here in a small stone house on six steps, where magi kept watch, father to son. Two centuries later Alexander found it robbed and had it restored."
  },
  "cyrus_cylinder": {
   "title": "The Cyrus Cylinder",
   "epithet": "A careful reading",
   "text": "A clay cylinder written in Babylonian cuneiform after Cyrus, 'king of Anšan', took Babylon in 539 BC, and buried in the city's wall. In the manner of Mesopotamian kings, it says Marduk chose Cyrus, blames the previous king, and says Cyrus entered Babylon without battle, returned the images of gods to their shrines in a list of cities from Aššur and Susa to the Zagros, and gathered their people and gave them back their homes. It does not name the Jews; their return is told in the Hebrew Bible. Often called the first charter of human rights, and treasured in Iran today, it is to historians a royal proclamation of a policy of restoring local cults and peoples."
  }
 },
