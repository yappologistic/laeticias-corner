 "cards": {
  "capua": {
   "kind": "landmark",
   "title": "Capua",
   "epithet": "The city of Campania",
   "text": "The great city of the Campanian plain, on the Via Appia. Its amphitheatre was one of the largest in Italy; an inscription records that Hadrian restored it. The city's monuments are not drawn here: the stop shows the road between houses, a posting station and tombs made of common Roman pieces."
  },
  "perfumer": {
   "kind": "role",
   "title": "Unguentaria",
   "epithet": "",
   "text": "Capua's Seplasia was a whole street of perfume sellers, famous across Italy for their scented oils."
  }
 },
 "strings": {
  "first_visit": "Capua: the Via Appia runs between shops and tombs past a posting station.",
  "market_day": "Market day: stalls, voices and goods from the country around.",
  "market_rain": "Rain: the stallholders cover their goods and wait under the eaves.",
  "lamps_lit": "Dusk: the lamps are lit along the street.",
  "wedding": "A wedding: the bride is led to her new home with torches and songs.",
  "ploughing_out": "The plough teams go out at first light.",
  "evening_cool": "Neighbours sit out in the evening cool.",
