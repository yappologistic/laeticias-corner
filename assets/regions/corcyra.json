 "cards": {
  "corcyra": {
   "kind": "landmark",
   "title": "Kerkyra",
   "epithet": "Island of the strong fleet",
   "text": "A rich island city with the second fleet of Greece, allied to Athens since 433. Its old temple of Artemis, with a Gorgon in the pediment, is not drawn here: the stop shows a harbour, houses and a shrine made of common Greek pieces."
  },
  "corcyra_fleet": {
   "kind": "role",
   "title": "Rower",
   "epithet": "",
   "text": "Kerkyra's 120 triremes made the second fleet of Greece; the quarrel over it led Athens to an alliance in 433."
  }
 },
 "strings": {
  "first_visit": "Kerkyra: a harbour on the island's east shore.",
  "market_day": "Market day: stalls, voices and goods from the country around.",
  "market_rain": "Rain: the stallholders cover their goods and wait under the eaves.",
  "lamps_lit": "Dusk: the lamps are lit along the street.",
  "wedding": "A wedding: the bride is led to her new home with torches and songs.",
  "shearing": "Shearing time: the flocks come in.",
  "threshing": "The threshing floors are busy from dawn.",
  "vintage": "The vintage: the grapes are trodden in the vats.",
  "rural_dionysia": "The country Dionysia: a procession with songs, a goat and the aulos.",
  "season_turn.spring": "The swallows are back under the eaves.",
  "season_turn.summer": "The cicadas have started.",
  "season_turn.autumn": "The grapes are in: the vintage begins.",
  "season_turn.winter": "The sea is closed. Ships are hauled up on the shore for the winter."
 },
