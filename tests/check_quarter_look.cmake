# The perf log of terrain_quarter_look.lcs: the process stays within MIB (CLAUDE.md
# "Performance": bounded memory) and, once the first frames have built the cells, no frame
# draws more than CALLS times (a pass drawn outside its page runs multiplies them).
file(STRINGS "${FILE}" lines)
list(LENGTH lines n)
if(n LESS 100)
  message(FATAL_ERROR "${FILE}: ${n} lines: the run did not finish its frames")
endif()
list(GET lines 0 header)
string(REPLACE "," ";" cols "${header}")
list(FIND cols "total_mib" mibCol)
list(FIND cols "draw_calls" callCol)
if(mibCol LESS 0 OR callCol LESS 0)
  message(FATAL_ERROR "${FILE}: no total_mib or draw_calls column")
endif()
set(worstMib 0)
set(worstCalls 0)
math(EXPR last "${n} - 1")
foreach(i RANGE 1 ${last})
  list(GET lines ${i} line)
  string(REPLACE "," ";" v "${line}")
  list(GET v ${mibCol} mib)
  list(GET v ${callCol} calls)
  string(REGEX REPLACE "\\..*" "" mib "${mib}")
  if(mib GREATER worstMib)
    set(worstMib ${mib})
  endif()
  if(i GREATER 5 AND calls GREATER worstCalls)
    set(worstCalls ${calls})
  endif()
endforeach()
message(STATUS "largest process ${worstMib} MiB, most draw calls in a frame ${worstCalls}")
if(worstMib GREATER MIB)
  message(FATAL_ERROR "the process reached ${worstMib} MiB (at most ${MIB})")
endif()
if(worstCalls GREATER CALLS)
  message(FATAL_ERROR "a frame drew ${worstCalls} times (at most ${CALLS})")
endif()
