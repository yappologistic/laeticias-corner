# Builds an assets directory with one change (everything else linked to the real assets) for a
# scripted run: VARIANT missing_art drops the cliff sprites; no_resident turns the resident off.
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(changed atlas.json catalog.json)
file(READ "${SRC}/atlas.json" atlas)
file(READ "${SRC}/catalog.json" catalog)
if(VARIANT STREQUAL "missing_art")
  string(JSON atlas REMOVE "${atlas}" sprites edge/cliff_se)
  string(JSON atlas REMOVE "${atlas}" sprites edge/cliff_sw)
elseif(VARIANT STREQUAL "no_resident")
  string(JSON catalog SET "${catalog}" resident enabled false)
else()
  message(FATAL_ERROR "unknown VARIANT '${VARIANT}'")
endif()
file(WRITE "${OUT}/atlas.json" "${atlas}")
file(WRITE "${OUT}/catalog.json" "${catalog}")
file(GLOB entries RELATIVE "${SRC}" "${SRC}/*")
foreach(entry IN LISTS entries)
  if(NOT entry IN_LIST changed)
    file(CREATE_LINK "${SRC}/${entry}" "${OUT}/${entry}" SYMBOLIC)
  endif()
endforeach()
