# The --perf-log CSV: its header, then one line per frame with as many values as columns.
file(STRINGS "${FILE}" lines)
list(LENGTH lines n)
math(EXPR want "${FRAMES} + 1")
if(NOT n EQUAL want)
  message(FATAL_ERROR "${FILE}: ${n} lines, expected ${want}")
endif()
list(GET lines 0 header)
list(GET lines 1 first)
string(REGEX MATCHALL "," hc "${header}")
string(REGEX MATCHALL "," fc "${first}")
list(LENGTH hc a)
list(LENGTH fc b)
if(NOT a EQUAL b OR NOT header MATCHES "^frame,frame_ms,")
  message(FATAL_ERROR "${FILE}: header and lines disagree")
endif()
