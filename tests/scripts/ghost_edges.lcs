# Large ghosts at every corner and edge, in every rotation, draw without touching memory outside
# the map (run under the sanitizers), and only placements that fit are made.
set unlock all
click ui:build
wait 3
click ui:tab:homes
wait 3
click ui:tile:barn
wait 3
move @0,0
wait 2
move @39,0
wait 2
move @0,39
wait 2
move @39,39
wait 2
key r
move @0,0
wait 2
move @39,39
wait 2
key r
move @0,0
wait 2
move @0,39
wait 2
key r
move @39,0
wait 2
move @0,0
wait 2
click @0,0
expect count barn 0
click @34,30
expect count barn 1
quit
