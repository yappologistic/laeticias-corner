# The shader path at night and on arrival (QA V6-011, V6-012, V6-020): night water is still
# water (not one flat colour), the same place is exposed alike at 1x and at half scale, and after
# a jump the frame's brightness holds (the exposure is taken on arrival, then eases).
set season summer
set weather clear
set time 0.75
set world 281 480 1
wait 60
expect contrast 100,300,600,300 2
set world 251 721 1
wait 60
expect luma_mark piraeus 0,0,1600,900
set world 251 721 0.5
wait 60
expect luma_like piraeus 400,225,800,450 0.15
set world 344 490 1
wait 60
expect luma_mark delos 0,0,1600,900
set world 344 490 0.5
wait 60
expect luma_like delos 400,225,800,450 0.15
set time 0.25
set world forum 1
wait 60
set world 50 1215 1
wait 2
expect luma_mark arrival 0,100,1600,700
wait 28
expect luma_like arrival 0,100,1600,700 0.05
quit
