# Undo in the middle of a paint drag undoes the stroke so far and ends the drag: nothing more is
# painted until the button is pressed again, and later strokes are separate steps.
click ui:build
wait 12
click ui:tab:terrain
wait 12
click ui:tile:water
wait 12
press @33,28
move @33,29
move @33,30
wait 2
expect tile @33,29 water
key ctrl+z
expect tile @33,28 grass
expect tile @33,29 grass
move @33,31
move @34,31
wait 2
release @34,31
expect tile @33,31 grass
expect tile @34,31 grass
expect undo no
expect redo yes
drag @33,28 @33,29
drag @35,28 @35,29
key ctrl+z
expect tile @35,28 grass
expect tile @33,28 water
quit
