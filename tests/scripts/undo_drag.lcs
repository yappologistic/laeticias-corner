# Undo in the middle of a paint drag undoes the stroke so far and ends the drag: nothing more is
# painted until the button is pressed again, and later strokes are separate steps.
click ui:build
wait 12
click ui:tab:terrain
wait 12
click ui:tile:water
wait 12
press @9,20
move @9,21
move @9,22
wait 2
expect tile @9,21 water
key ctrl+z
expect tile @9,20 grass
expect tile @9,21 grass
move @9,23
move @10,23
wait 2
release @10,23
expect tile @9,23 grass
expect tile @10,23 grass
expect undo no
expect redo yes
drag @9,20 @9,21
drag @11,20 @11,21
key ctrl+z
expect tile @11,20 grass
expect tile @9,20 water
quit
