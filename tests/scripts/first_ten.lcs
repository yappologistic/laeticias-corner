# A new player's first ten minutes (docs/design/living-corner.md §1.3), with play time and
# growth stepped forward where real minutes would pass. Laeticia speaks only through her wishes
# this round, and the title screen and tour come later.
# 0:05 the cleared corner, wild land behind it, ducks already on the pond.
expect count all 16
expect stage 0
expect wishes 0
wait 90
expect seen duck
shot shots/ten_00_start.png
# 0:30 the first wish: four flower patches. The starter scene has two; plant two more.
set played 30
wait 4
expect wish first_flowers open
shot shots/ten_01_first_wish.png
click ui:build
wait 3
click ui:tab:nature
wait 3
click ui:tile:flowers_white
wait 3
click @24,34
click @25,34
key escape
wait 20
set played +2
wait 4
expect wish first_flowers done
expect ribbon yes
wait 60
expect seen butterfly
shot shots/ten_02_granted.png
# 1:30 a roof: the cottage, and the cat moves in at once.
set played +31
wait 4
expect wish a_roof open
click ui:build
wait 3
click ui:tab:homes
wait 3
click ui:tile:cottage
wait 3
click @34,31
key escape
wait 20
set played +2
wait 4
expect wish a_roof done
wait 90
expect seen cat
# 3:00 two wishes open at once: a path to the door, a bench by the cottage.
set played +31
wait 4
expect wish path_to_door open
set played +76
wait 4
expect wish cat_bench open
expect wishes 2
shot shots/ten_03_two_wishes.png
click ui:build
wait 3
click ui:tab:terrain
wait 3
click ui:tile:path
wait 3
drag @33,31 @33,33
click ui:build
wait 3
click ui:tab:garden
wait 3
click ui:tile:bench
wait 3
click @36,33
key escape
wait 20
set played +2
wait 4
expect wish path_to_door done
expect wish cat_bench done
# 4:30 three veggie beds, then the hen coop they unlock; hens make the fourth page and the
# west meadow opens.
set played +31
wait 4
expect wish three_beds open
click ui:build
wait 3
click ui:tab:garden
wait 3
click ui:tile:planter
wait 3
drag @31,35 @33,35
key escape
wait 20
set played +2
wait 4
expect wish three_beds done
click ui:build
wait 3
click ui:tab:homes
wait 3
click ui:tile:coop
wait 3
click @37,31
key escape
wait 120
expect seen hen
expect stage 1
shot shots/ten_04_meadow.png
# 6:00 dusk: a lamp and a tree beside the bench make the reading nook.
click ui:build
wait 3
click ui:tab:garden
wait 3
click ui:tile:lamp
wait 3
click @30,29
click ui:build
wait 3
click ui:tab:nature
wait 3
click ui:tile:blossom
wait 3
click @28,28
key escape
set clock dusk
wait 30
expect nook reading_nook yes
shot shots/ten_05_nook.png
# The evening wish: a light by a bench, already there, granted moments after it is offered.
set played +31
wait 4
expect wish first_harvest open
set played +76
wait 4
expect wish reading_light open
set played +4
wait 4
expect wish reading_light done
# 9:00 dawn: the beds have ripened; the first ripe bed is explained; pick one.
set grow 540
set clock dawn
wait 30
expect growth @31,35 3
move @31,35
wait 30
shot shots/ten_06_ripe.png
click @31,35
wait 10
expect harvests 1
set played +2
wait 4
expect wish first_harvest done
# 10:00 more wishes open, five pages, new land to fill.
set played +31
wait 4
key j
wait 12
shot shots/ten_07_sketchbook.png
key j
wait 12
shot shots/ten_08_end.png
quit
