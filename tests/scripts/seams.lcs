# No seams: the world target under the window holds no partly transparent pixels (a line
# between cached ground pieces, a hole) at the home and in a city, at 1x, 2x and 3x. Run on
# the classic frame and on the shader path (the owner saw such lines cross the home's view at
# 2x: the ground cache filtered its slots at whole scales).
set season spring
set weather clear
set time 0.25
set world 55 1220 1
wait 30
expect target_alpha 0,0,1580,845 0.0005
set world 55 1220 2
wait 30
expect target_alpha 0,0,1580,845 0.0005
set world 60 1225 3
wait 30
expect target_alpha 0,0,1580,845 0.0005
set world forum 1
wait 40
expect target_alpha 0,0,1580,845 0.0005
set world forum 2
wait 30
expect target_alpha 0,0,1580,845 0.0005
set world forum 3
wait 30
expect target_alpha 0,0,1580,845 0.0005
quit
