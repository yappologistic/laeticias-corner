# Painting by drag, the land/water rule, and undo of whole strokes.
click ui:build
wait 3
click ui:tab:terrain
wait 3
shot shots/drawer_ground.png
click ui:tile:water
wait 3
expect tool paint
drag @24,31 @24,35
expect tile @24,31 water
expect tile @24,33 water
expect tile @24,35 water
# Tall grass at 31,27 refuses water underneath; wild land at 19,27 refuses any paint.
drag @31,26 @31,30
expect tile @31,26 water
expect tile @31,27 grass
expect tile @31,28 water
expect tile @31,30 water
move @31,27
wait 6
shot shots/paint_refused.png
key ctrl+z
expect tile @31,28 grass
expect tile @24,33 water
key ctrl+z
expect tile @24,33 grass
expect undo no
click ui:build
wait 3
click ui:tile:path
wait 3
drag @20,35 @24,39
expect tile @20,35 path
expect tile @24,39 path
wait 10
shot shots/paint_path.png
quit
