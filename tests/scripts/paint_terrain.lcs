# Painting by drag, the land/water rule, and undo of whole strokes.
click ui:build
wait 12
click ui:tab:terrain
wait 12
shot shots/drawer_ground.png
click ui:tile:water
wait 12
expect tool paint
drag @22,33 @22,37
expect tile @22,33 water
expect tile @22,35 water
expect tile @22,37 water
# Mushrooms at 9,24 and an oak at 9,26 refuse water underneath.
drag @9,22 @9,27
expect tile @9,22 water
expect tile @9,23 water
expect tile @9,24 grass
expect tile @9,25 water
expect tile @9,26 grass
expect tile @9,27 water
move @9,26
wait 6
shot shots/paint_refused.png
key ctrl+z
expect tile @9,23 grass
expect tile @22,35 water
key ctrl+z
expect tile @22,35 grass
expect undo no
click ui:build
wait 12
click ui:tile:path
wait 12
drag @20,35 @24,39
expect tile @20,35 path
expect tile @24,39 path
wait 10
shot shots/paint_path.png
quit
