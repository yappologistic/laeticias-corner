# Regression: drawer tiles laid out for one tab must never be drawn or picked as another tab's
# entries. Clicking the ground tab while an item tab was shown used to draw item tiles as terrain
# in the same frame and crash.
click ui:build
wait 2
# Every tab after every other one, mid-animation and with no frames between clicks.
click ui:tab:homes
click ui:tab:terrain
click ui:tab:garden
click ui:tab:terrain
click ui:tab:nature
click ui:tab:terrain
click ui:tab:homes
click ui:tab:garden
click ui:tab:nature
click ui:tab:homes
wait 20
click ui:tab:terrain
wait 1
click ui:tab:nature
wait 20
# Hover a tile, then switch away under the pointer.
move ui:tile:lily_pads
wait 10
click ui:tab:terrain
wait 2
move ui:tile:water
wait 10
click ui:tab:garden
# Close and reopen while switching.
key b
click ui:tab:terrain
wait 3
key b
wait 3
click ui:tab:homes
key b
wait 20
expect drawer closed
key b
wait 20
expect drawer open
# Tiles still pick what they show after all that.
click ui:tab:terrain
wait 1
click ui:tile:water
expect tool paint
key b
wait 20
click ui:tab:homes
wait 1
click ui:tile:windmill
expect tool place
key b
wait 20
click ui:tab:garden
wait 2
shot shots/drawer_tabs.png
quit
