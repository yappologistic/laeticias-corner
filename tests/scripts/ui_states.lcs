move ui:undo
wait 45
shot shots/tooltip_undo.png
click ui:journal
wait 15
expect journal open
shot shots/journal.png
click ui:journal_close
wait 15
expect journal closed
# Small wheel deltas add up to one step; one notch is one step.
expect zoom 0.5
wheel 0.1 @30,30
wheel 0.1 @30,30
wheel 0.1 @30,30
expect zoom 0.5
wheel 1 @30,30
wait 30
expect zoom 1
key minus
wait 30
expect zoom 0.5
click ui:zoom_in
wait 30
expect zoom 1
key home
expect zoom 0.5
# Clicks on the interface never reach the map behind it.
click ui:build
wait 12
click ui:tab:nature
wait 12
click ui:tile:oak
wait 12
click ui:sound
expect muted yes
click ui:sound
expect muted no
expect count oak 4
key b
wait 12
shot shots/drawer_nature.png
quit
