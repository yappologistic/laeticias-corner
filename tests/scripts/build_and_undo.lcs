# Build drawer -> pick -> ghost -> place, rotate, refuse overlaps, remove, undo/redo,
# and a drag of fences that undoes as one step.
click ui:build
wait 12
expect drawer open
click ui:tab:homes
wait 12
shot shots/drawer_homes.png
click ui:tile:cottage
wait 12
expect tool place
expect drawer closed
move @24,32
wait 20
shot shots/placing_cottage.png
key r
click @24,32
wait 4
expect item @24,32 cottage
expect item @25,33 cottage
expect count cottage 1
click @25,33
expect count cottage 1
move @34,24
wait 4
shot shots/placing_invalid.png
click @34,24
expect count cottage 1
key ctrl+z
expect count cottage 0
expect redo yes
key ctrl+shift+z
expect count cottage 1
key x
expect tool remove
move @25,32
wait 6
shot shots/remove_hover.png
click @25,32
expect count cottage 0
key ctrl+z
expect count cottage 1
key escape
expect tool none
click ui:build
wait 12
click ui:tab:garden
wait 12
click ui:tile:fence
wait 12
drag @32,30 @37,30
wait 4
expect count fence 6
key ctrl+z
expect count fence 0
key ctrl+y
expect count fence 6
wait 40
shot shots/fences.png
quit
