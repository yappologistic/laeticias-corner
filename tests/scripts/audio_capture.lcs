# Drives tuned placement notes, a drag-paint, the first wish (its melody stem joins on a bar
# line and fades in), a mute toggle and a day/night crossfade while the mix is captured.
set unlock all
set clock day
click ui:build
wait 12
click ui:tab:nature
wait 12
click ui:tile:flowers_white
wait 12
click @24,34
click @25,34
click @26,34
click ui:build
wait 12
click ui:tab:terrain
wait 12
click ui:tile:water
wait 12
drag @31,28 @36,33
key escape
set played 30
wait 2
set played 34
wait 2
expect wish first_flowers done
wait 300
key m
wait 30
key m
wait 30
click ui:clock
click ui:clock
wait 150
expect phase night
quit
