# A fresh corner shows the starter scene framed clear of the interface, and the ducks find the
# pond on their own (their first sighting is announced).
expect count all 16
expect tile @34,24 water
expect item @34,24 lily_pads
expect item @29,29 bench
expect item @37,37 oak
expect tile @27,36 path
expect tool none
expect phase day
wait 120
expect seen duck
expect toast yes
expect habitat ok
shot shots/launch_@SIZE@.png
quit
