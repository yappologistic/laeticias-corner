# Building what visitors need brings them in; they show up in the journal. Day visitors stay
# through dusk; fireflies come out only at night.
set unlock all
set season summer
click ui:build
wait 12
click ui:tab:homes
wait 12
click ui:tile:cottage
wait 12
click @24,32
click ui:build
wait 12
click ui:tile:coop
wait 12
click @20,31
click ui:build
wait 12
click ui:tab:garden
wait 12
click ui:tile:beehive
wait 12
click @33,30
click ui:build
wait 12
click ui:tab:nature
wait 12
click ui:tile:flowers_red
wait 12
drag @32,32 @34,32
click ui:build
wait 12
click ui:tile:tall_grass
wait 12
click @32,30
key escape
wait 150
expect seen cat
expect seen hen
expect seen bee
expect seen butterfly
expect habitat ok
key j
wait 15
shot shots/visitors_journal.png
key j
set clock dusk
wait 60
expect present firefly 0
set clock night
wait 90
expect seen firefly
shot shots/visitors_night.png
quit
