# Building what visitors need brings them in; they show up in the journal. Day visitors stay
# through dusk; fireflies come out only at night.
click ui:build
wait 12
click ui:tab:homes
wait 12
click ui:tile:cottage
wait 12
click @12,16
click ui:build
wait 12
click ui:tile:coop
wait 12
click @20,31
click ui:build
wait 12
click ui:tab:garden
wait 12
click ui:tile:beehive
wait 12
click @17,14
click ui:build
wait 12
click ui:tab:nature
wait 12
click ui:tile:flowers_red
wait 12
drag @16,12 @18,12
key escape
wait 150
expect seen cat
expect seen hen
expect seen bee
expect seen butterfly
expect habitat ok
key j
wait 15
shot shots/visitors_journal.png
key j
set clock dusk
wait 60
expect present firefly 0
set clock night
wait 90
expect seen firefly
shot shots/visitors_night.png
quit
