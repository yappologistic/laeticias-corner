# Building what visitors need brings them in; they show up in the journal.
click ui:build
wait 12
click ui:tab:homes
wait 12
click ui:tile:cottage
wait 12
click @6,12
click ui:build
wait 12
click ui:tile:coop
wait 12
click @11,15
click ui:build
wait 12
click ui:tab:garden
wait 12
click ui:tile:beehive
wait 12
click @5,6
click ui:build
wait 12
click ui:tab:nature
wait 12
click ui:tile:flowers_red
wait 12
drag @6,3 @6,5
key escape
wait 600
expect seen cat
expect seen hen
expect seen bee
expect seen butterfly
key j
wait 15
shot shots/visitors_journal.png
key j
set clock night
wait 300
expect seen firefly
shot shots/visitors_night.png
quit
