# The owl: a stump among three pines at night. Once the recipe has held a while it comes, with
# its first sighting announced; the sketchbook shows it among the rarer visitors.
set unlock all
click ui:build
wait 10
click ui:tab:nature
wait 10
click ui:tile:stump
wait 10
click @35,30
click ui:build
wait 10
click ui:tile:pine
wait 10
click @34,29
click @36,29
click @36,31
key escape
set clock night
wait 20
expect seen owl no
set played 100
wait 120
expect seen owl
expect toast yes
shot shots/rare_owl.png
quit
