---
# Bug-finding and performance checks. Disabled on purpose:
#  - signed-bitwise: neighbour masks and hashes are small non-negative ints by construction;
#  - misplaced-widening-cast: index casts of bounded grid/sprite coordinates;
#  - inefficient-string-concatenation: only on load-time error/key building, never per frame;
#  - no-malloc/owning-memory: they flag the RAII deleters that wrap SDL's C API.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-signed-bitwise,
  -bugprone-misplaced-widening-cast,
  cert-err33-c,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-slicing,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-make-unique,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-emplace,
  performance-*,
  -performance-enum-size,
  -performance-inefficient-string-concatenation,
  readability-container-size-empty,
  readability-redundant-string-cstr,
  readability-simplify-boolean-expr,
WarningsAsErrors: ''
HeaderFilterRegex: '.*/src/.*'
FormatStyle: file
...
